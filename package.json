{
  "name": "cypressdemoproject",
  "description": "CypressDemoProject",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down -v",
    "stack:wait": "wait-on -t 120000 http://localhost:4000/api/health http://localhost:8080",
    "test:e2e": "start-server-and-test stack:up http://localhost:4000/api/health,http://localhost:8080 cy:run",
    "perf:login": "artillery run perf/login-load.yml",
    "perf:transactions": "artillery run perf/transactions-load.yml",
    "perf": "npm run perf:login && npm run perf:transactions"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@testing-library/cypress": "^10.1.3",
    "artillery": "^2.0.34",
    "axe-core": "^4.12.1",
    "cypress": "^15.18.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.2.1",
    "joi": "^18.2.3",
    "pg": "^8.13.1",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.0.9",
    "wait-on": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arianefrancaqa/CypressDemoProject.git"
  },
  "keywords": [
    "cypress",
    "e2e",
    "api",
    "GUI"
  ],
  "author": "Ariane França",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arianefrancaqa/CypressDemoProject/issues"
  },
  "homepage": "https://github.com/arianefrancaqa/CypressDemoProject#readme"
}
